# ============================================================================
# Neeva AI Backend — Zero-Cost (₹0 Budget) Environment Template
# Starts and runs 100% locally without any cloud project, billing account, or API key.
# ============================================================================

# Zero-Cost Mode (Strict ₹0 budget — disables all paid cloud APIs by default)
ZERO_COST_MODE=true

# Durable Local SQLite WAL Database
DATABASE_MODE=sqlite_wal
LOCAL_FIRESTORE_DB_PATH=data/neeva_zero_cost.sqlite3

# Local Zero-Cost Authentication (PBKDF2-HMAC-SHA256 + HMAC-SHA256 JWT)
AUTH_MODE=local
LOCAL_JWT_EXPIRY_HOURS=24

# AI Provider A: Local CPU Open-Source Model (Optional local Ollama / llama.cpp endpoint)
ENABLE_LOCAL_OPEN_SOURCE_AI=true
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL_NAME=gemma2:2b
ENABLE_LOCAL_HF_PIPELINE=false
LOCAL_HF_ALLOW_DOWNLOAD=false

# AI Provider B: Optional Free-Tier Gemini (Disabled by default; NEVER uses paid Vertex AI)
ENABLE_OPTIONAL_GEMINI_FREE_TIER=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Paid Cloud Services — Strictly Disabled by Default
ENABLE_OPTIONAL_CLOUD_DLP=false
ENABLE_OPTIONAL_VERTEX_ENDPOINTS=false
FIRESTORE_REQUIRE_LIVE=false
FIREBASE_APP_CHECK_ENFORCE=false

# Runtime Settings
ENVIRONMENT=development
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
MAX_CHAT_MESSAGES=40
MAX_REQUEST_BYTES=65536
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_DEFAULT=120/minute
LOG_LEVEL=INFO
