# ============================================================================
# Neeva AI Backend — Environment Configuration Template
# Strict Google-Only Stack (Cloud Run, Cloud Firestore, Firebase Auth, Gemini, DLP, Vertex AI)
# ============================================================================

# Google Cloud & Firebase Project
GOOGLE_CLOUD_PROJECT=onyx-gift-514504-q0
FIREBASE_PROJECT_ID=onyx-gift-514504-q0
DLP_REGION=asia-south1
VERTEX_AI_REGION=asia-south1
SECRET_MANAGER_PREFIX=projects/onyx-gift-514504-q0/secrets

# Cloud Firestore Operational Database
FIRESTORE_DATABASE_ID=(default)
# Set to true in production to fail closed if live Firestore is unreachable
FIRESTORE_REQUIRE_LIVE=false
# Local Firestore emulator host (optional, e.g., 127.0.0.1:8085)
FIRESTORE_EMULATOR_HOST=
# Cross-process persistent SQLite WAL file used in local development/test mode
LOCAL_FIRESTORE_DB_PATH=.neeva_local_firestore.sqlite3

# Firebase Authentication & App Check
# Leave FIREBASE_CREDENTIALS_PATH empty in Cloud Run (uses Application Default Credentials)
FIREBASE_CREDENTIALS_PATH=
FIREBASE_WEB_API_KEY=
FIREBASE_APP_CHECK_ENFORCE=false

# Google AI Studio / Vertex AI (`google-genai` SDK — Gemini 2.5 Flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=25.0
GEMINI_MAX_RETRIES=2

# Google MuRIL & Vertex AI Gemma Endpoints
MURIL_ONNX_PATH=models/muril/muril_distress.onnx
MURIL_HF_CHECKPOINT=google/muril-base-cased
VERTEX_GEMMA_9B_ENDPOINT=
VERTEX_GEMMA_2B_ENDPOINT=
VERTEX_TIMEOUT_SECONDS=15.0

# Application Runtime ("development" | "test" | "production")
ENVIRONMENT=development
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
MAX_CHAT_MESSAGES=40
MAX_REQUEST_BYTES=65536
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_DEFAULT=100/minute
LOG_LEVEL=INFO
