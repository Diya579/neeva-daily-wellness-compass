# ============================================================================
# Neeva AI Backend — Environment Configuration Template
# Strict Google-Only Stack (Cloud Run, Cloud SQL, Firebase Auth, Gemini, DLP)
# ============================================================================

# Google Cloud Project
GOOGLE_CLOUD_PROJECT=neeva-ai-prod
DLP_REGION=asia-south1
SECRET_MANAGER_PREFIX=projects/neeva-ai-prod/secrets

# Cloud SQL for PostgreSQL (use Cloud SQL Auth Proxy locally or Unix socket in Cloud Run)
DATABASE_URL=postgresql+asyncpg://neeva_app:CHANGE_ME@localhost:5432/neeva_db

# Firebase Authentication
FIREBASE_PROJECT_ID=neeva-ai-prod
# Leave empty in Cloud Run (uses Application Default Credentials); set path for local dev
FIREBASE_CREDENTIALS_PATH=
FIREBASE_WEB_API_KEY=
FIREBASE_APP_CHECK_ENFORCE=false

# Google AI Studio / Vertex AI (@google/genai SDK — Gemini 2.5 Flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Model Serving Paths / Vertex AI Endpoints
MURIL_ONNX_PATH=models/muril/muril_distress.onnx
VERTEX_AI_REGION=asia-south1
VERTEX_GEMMA_9B_ENDPOINT=
VERTEX_GEMMA_2B_ENDPOINT=

# Application Runtime
ENVIRONMENT=development
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
MAX_CHAT_MESSAGES=40
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_DEFAULT=100/minute
LOG_LEVEL=INFO

