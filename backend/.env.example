# ============================================================================
# Neeva AI Backend — Environment Template (Local-First SQLite WAL + Gemini 2.5 Flash)
# ============================================================================

# Zero-Cost / Credit-Card-Free Mode
ZERO_COST_MODE=true
DATABASE_MODE=local_sqlite
LOCAL_SQLITE_DB_PATH=sqlite.db
LOCAL_FIRESTORE_DB_PATH=data/neeva_zero_cost.sqlite3

# Voice Mode: browser_native disables paid server-side Cloud STT/TTS
VOICE_MODE=browser_native

# Authentication Mode (local PBKDF2/JWT + Firebase Free Spark Auth)
AUTH_MODE=local
LOCAL_JWT_EXPIRY_HOURS=24
FIREBASE_PROJECT_ID=neeva-wellness-platform

# Gemini 2.5 Flash (Google AI Studio Free Tier API Key via google-genai SDK)
ENABLE_OPTIONAL_GEMINI_FREE_TIER=true
GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_MODEL=gemini-2.5-flash

# Optional Local Open-Source LLM (Ollama / llama.cpp)
ENABLE_LOCAL_OPEN_SOURCE_AI=true
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL_NAME=gemma2:2b

# Paid Cloud Services — Disabled to Enforce ₹0 Credit-Card-Free Operation
ENABLE_OPTIONAL_CLOUD_DLP=false
ENABLE_OPTIONAL_VERTEX_ENDPOINTS=false
FIRESTORE_REQUIRE_LIVE=false
FIREBASE_APP_CHECK_ENFORCE=false

# Runtime Settings
ENVIRONMENT=development
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
MAX_CHAT_MESSAGES=40
MAX_REQUEST_BYTES=65536
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_DEFAULT=120/minute
LOG_LEVEL=INFO
